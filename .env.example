# Local development only. Replace all secrets before use.
NODE_ENV=development
APP_NAME=SentinelAI
WEB_PORT=3000
API_PORT=4000
AI_ENGINE_PORT=8000
WEB_ORIGIN=http://localhost:3000
# Set only behind a trusted reverse proxy; use the exact trusted hop count.
# TRUST_PROXY_HOPS=1

# Optional: enable private Prometheus scraping with a secret of at least 32 characters.
# METRICS_BEARER_TOKEN=replace-with-at-least-32-random-characters
# GRAFANA_ADMIN_PASSWORD=choose-a-unique-local-password (required for local monitoring overlay)

# PostgreSQL
POSTGRES_DB=sentinelai
POSTGRES_USER=sentinelai
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgresql://sentinelai:change-this-local-password@localhost:5432/sentinelai?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Auth secrets: generate two independent random values of at least 32 bytes.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-bytes
JWT_REFRESH_SECRET=replace-with-a-different-32-random-bytes

# Optional private S3-compatible evidence storage. Configure all required values together.
# Production requires an HTTPS endpoint and a private bucket with public access blocked.
# # Evidence retention: 0 disables terminal-evidence expiry; default is 365 days.
EVIDENCE_RETENTION_DAYS=365
# Generate a unique random value of at least 32 characters; required by scheduled cleanup.
EVIDENCE_RETENTION_CRON_TOKEN=
EVIDENCE_S3_ENDPOINT=https://s3.example.com
# EVIDENCE_S3_BUCKET=sentinelai-private-evidence
# EVIDENCE_S3_REGION=us-east-1
# EVIDENCE_S3_ACCESS_KEY_ID=replace-with-least-privilege-access-key
# EVIDENCE_S3_SECRET_ACCESS_KEY=replace-with-secret-access-key
# EVIDENCE_S3_SESSION_TOKEN=optional-temporary-credential-session-token

# Private evidence malware scanning (required when evidence storage is enabled in production).
# Run a maintained ClamAV daemon on a private network; never expose clamd publicly.
# CLAMAV_HOST=clamav.internal
# CLAMAV_PORT=3310
