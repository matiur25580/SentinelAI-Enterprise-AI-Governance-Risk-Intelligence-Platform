generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  OWNER
  ADMIN
  AI_GOVERNANCE
  AI_ENGINEER
  SECURITY_ANALYST
  COMPLIANCE_OFFICER
  FINANCE_MANAGER
  AUDITOR
  MEMBER
}

enum AssetType {
  FOUNDATION_MODEL
  LLM_APPLICATION
  AI_AGENT
  MACHINE_LEARNING_MODEL
  EMBEDDING_MODEL
  OTHER
}

enum AssetStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  ACTIVE
  SUSPENDED
  RETIRED
}

enum RiskAssessmentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
}

enum EvidenceFileStatus {\n  PENDING_UPLOAD\n  UPLOADED\n  VERIFIED\n  REJECTED\n}\n\nenum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Organization {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]
  assets      AIAsset[]
  refreshTokens RefreshToken[]
  auditLogs   AuditLog[]
  auditChainHead AuditChainHead?
  riskAssessments RiskAssessment[]\n  evidenceFiles EvidenceFile[]

  @@index([isActive])
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String
  passwordHash String
  isActive     Boolean        @default(true)
  emailVerifiedAt DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  memberships  Membership[]
  refreshTokens RefreshToken[]
  auditLogs    AuditLog[]     @relation("AuditActor")

  @@index([isActive])
}

model Membership {
  id             String         @id @default(cuid())
  userId         String
  organizationId String
  role           MembershipRole @default(MEMBER)
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  refreshTokens  RefreshToken[]
  assets         AIAsset[]      @relation("AssetOwner")
  riskAssessmentsCreated RiskAssessment[] @relation("RiskAssessmentCreator")
  riskAssessmentsReviewed RiskAssessment[] @relation("RiskAssessmentReviewer")\n  evidenceFilesCreated EvidenceFile[] @relation("EvidenceFileCreator")\n  evidenceFilesVerified EvidenceFile[] @relation("EvidenceFileVerifier")

  @@unique([userId, organizationId])
  @@index([organizationId, role])
  @@index([userId, isActive])
}

model RefreshToken {
  id             String      @id @default(cuid())
  jti            String      @unique
  familyId       String
  tokenHash      String
  userId         String
  organizationId String
  membershipId   String
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime    @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership     Membership  @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([familyId, revokedAt])
  @@index([userId, revokedAt])
  @@index([organizationId])
  @@index([expiresAt])
}

model AIAsset {
  id             String      @id @default(cuid())
  organizationId String
  ownerId        String?
  name           String
  description    String?
  assetType      AssetType
  provider       String?
  modelIdentifier String?
  version        String?
  status         AssetStatus @default(DRAFT)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner          Membership? @relation("AssetOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  riskAssessments RiskAssessment[]

  @@index([organizationId, status])
  @@index([organizationId, assetType])
  @@index([ownerId])
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  actorId        String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  createdAt      DateTime     @default(now())
  chainSequence  BigInt       @default(0)
  previousHash   String       @default("")
  recordHash     String       @default("")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor          User?        @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([organizationId, chainSequence])
  @@index([organizationId, createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}

model AuditChainHead {
  organizationId String       @id
  lastSequence   BigInt       @default(0)
  lastHash       String       @default("")
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
}

model RiskAssessment {
  id                    String               @id @default(cuid())
  organizationId        String
  assetId               String
  createdByMembershipId String
  reviewedByMembershipId String?
  title                 String
  scope                 String
  intendedUse           String
  dataSensitivity       Int
  autonomyLevel         Int
  impact                Int
  likelihood            Int
  exposure              Int
  mitigationCoverage    Int                  @default(0)
  inherentScore         Float
  residualScore         Float
  inherentLevel         RiskLevel
  residualLevel         RiskLevel
  scoringVersion        String               @default("sentinelai-risk-v1")
  evidence              Json
  status                RiskAssessmentStatus @default(DRAFT)
  reviewRationale       String?
  submittedAt           DateTime?
  reviewedAt            DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  organization          Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  asset                 AIAsset              @relation(fields: [assetId], references: [id], onDelete: Restrict)
  createdByMembership  Membership           @relation("RiskAssessmentCreator", fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  reviewedByMembership Membership?          @relation("RiskAssessmentReviewer", fields: [reviewedByMembershipId], references: [id], onDelete: Restrict)\n  evidenceFiles          EvidenceFile[]

  @@index([organizationId, status, createdAt])
  @@index([organizationId, residualLevel])
  @@index([assetId, createdAt])
  @@index([createdByMembershipId])
}

model EvidenceFile {
  id                    String            @id @default(cuid())
  organizationId        String
  riskAssessmentId      String
  createdByMembershipId String
  verifiedByMembershipId String?
  storageKey            String            @unique
  originalFileName      String
  contentType           String
  sizeBytes             BigInt
  checksumSha256        String
  status                EvidenceFileStatus @default(PENDING_UPLOAD)
  uploadExpiresAt       DateTime
  uploadedAt            DateTime?
  verifiedAt            DateTime?
  verificationNote      String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  organization          Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  riskAssessment        RiskAssessment    @relation(fields: [riskAssessmentId], references: [id], onDelete: Restrict)
  createdByMembership   Membership        @relation("EvidenceFileCreator", fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  verifiedByMembership  Membership?       @relation("EvidenceFileVerifier", fields: [verifiedByMembershipId], references: [id], onDelete: Restrict)

  @@index([organizationId, riskAssessmentId, createdAt])
  @@index([organizationId, status])
  @@index([uploadExpiresAt, status])
}
